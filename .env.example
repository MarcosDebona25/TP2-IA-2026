# --- Proveedor LLM ---
# Valores: "groq" (default) | "gemini"
LLM_PROVIDER=groq

# Modelo a usar (opcional; si no se define, cada proveedor usa su default)
# groq default:   qwen/qwen3-32b
# gemini default: gemma-4-31b-it
# LLM_MODEL=

# --- Credenciales ---
GROQ_API_KEY=
GOOGLE_API_KEY=

LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=tp2-diabetes


LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="tp2-diabetes"

# MongoDB — historial de pacientes (modo completo). Sirve igual para MongoDB en Docker
# (docker/docker-compose.yml) o local nativo: ambos escuchan en el puerto 27017.
# En Windows, 127.0.0.1 evita demoras por la resolución IPv6 de localhost.
MONGO_URI=mongodb://127.0.0.1:27017