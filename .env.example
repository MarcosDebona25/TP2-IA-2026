# =============================================================================
# TP2 · Monitor Clínico DM2 — variables de entorno
#
# Copiar a .env (cp .env.example .env) y completar SOLO lo que se use.
# Formato: VAR=valor, sin comillas ni comentarios en la misma línea.
# Las líneas "# VAR=valor" son opcionales y muestran el valor por defecto.
# Sin API key del proveedor activo, los agentes corren en modo determinístico (sin LLM).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. Proveedor LLM (agents/llm_factory.py · ADR-0014, ADR-0020)
#
#   Proveedor       Key que usa                        Modelo por defecto
#   groq            GROQ_API_KEY                       openai/gpt-oss-120b
#   gemini          GOOGLE_API_KEY o GEMINI_API_KEY    gemini-2.5-flash-lite
#   openrouter      OPENROUTER_API_KEY                 deepseek/deepseek-v4-flash
#   openai_compat   LLM_API_KEY + LLM_BASE_URL         gpt-4o-mini
#
# DeepSeek directo (ADR-0021): openai_compat + LLM_BASE_URL=https://api.deepseek.com
# + LLM_MODEL=deepseek-flash (o deepseek-v4-pro). El razonamiento se desactiva solo.
# -----------------------------------------------------------------------------
LLM_PROVIDER=groq

# Modelo (vacío = el default del proveedor)
# LLM_MODEL=

# URL base de la API (solo openai_compat)
# LLM_BASE_URL=https://api.openai.com/v1

# Razonamiento de DeepSeek: disabled | enabled (default con DeepSeek: disabled, ADR-0021)
# LLM_THINKING=disabled


# -----------------------------------------------------------------------------
# 2. Credenciales LLM (solo la del proveedor activo y las de los respaldos)
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
LLM_API_KEY=


# -----------------------------------------------------------------------------
# 3. Ajustes del LLM (opcionales)
# -----------------------------------------------------------------------------
# Modo de los agentes (ADR-0015): lean = pocas llamadas (free tier) | react = loops ReAct completos
# AGENT_MODE=lean

# Respaldo si el modelo principal falla, como proveedor:modelo separados por coma (ADR-0016)
# Vacío = sin respaldo. Sin definir = default del proveedor (las entradas sin key se omiten).
# LLM_FALLBACK_MODELS=groq:openai/gpt-oss-120b

# Límite de tokens de salida
# LLM_MAX_TOKENS=4096

# Esfuerzo de razonamiento (solo modelos gpt-oss)
# LLM_REASONING_EFFORT=low

# Tiempo máximo por llamada en segundos (openrouter y openai_compat)
# LLM_TIMEOUT_S=45

# OpenRouter: deny = solo proveedores que no guardan ni entrenan con los datos
# OPENROUTER_DATA_COLLECTION=deny


# -----------------------------------------------------------------------------
# 4. Observabilidad con LangSmith (opcional · docs/logs.md)
# -----------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=tp2-diabetes
LANGSMITH_ENDPOINT=https://api.smith.langchain.com


# -----------------------------------------------------------------------------
# 5. Embeddings del RAG (rag/config.py · ADR-0017)
# -----------------------------------------------------------------------------
# multilingual = fastembed en proceso (~220 MB) | local = MiniLM-L6, solo inglés | ollama
# Cambiarlo exige reindexar: uv run python rag/ingest.py --rebuild
# EMBEDDING_PROVIDER=multilingual

# Carpeta del modelo de embeddings. Por defecto va a /tmp, que WSL/Linux vacía al reiniciar.
# FASTEMBED_CACHE_PATH=/home/USUARIO/.cache/fastembed

# Solo con EMBEDDING_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434


# -----------------------------------------------------------------------------
# 6. Historial de pacientes (tools/history_store.py · ADR-0005)
# -----------------------------------------------------------------------------
# sqlite = archivo local, sin servicios | mongo = MongoDB (docker/docker-compose.yml)
# HISTORY_BACKEND=sqlite
# HISTORY_DB_PATH=data/tp2.db

# Solo con HISTORY_BACKEND=mongo (127.0.0.1 evita demoras por IPv6 en Windows)
# MONGO_URI=mongodb://127.0.0.1:27017
